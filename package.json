{
  "name": "critter-quest",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "dev:https": "node tools/dev-https.mjs",
    "quest": "node tools/quest.mjs",
    "icons": "node tools/icons.mjs",
    "assetlinks": "node tools/assetlinks.mjs",
    "pwa:check": "node tools/pwa-check.mjs",
    "build": "tsc --noEmit -p tsconfig.tools.json && vite build",
    "preview": "vite preview --host",
    "test": "esbuild tools/smoke.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/smoke.mjs --log-level=error && node node_modules/.cache/smoke.mjs",
    "serve:dist": "node tools/serve.mjs",
    "predev": "node tools/icons.mjs && node tools/draco.mjs && node tools/modelos.mjs && node tools/gritos.mjs && node tools/maos.mjs",
    "prebuild": "node tools/icons.mjs && node tools/draco.mjs && node tools/modelos.mjs && node tools/gritos.mjs && node tools/maos.mjs",
    "render": "node tools/folha.mjs",
    "pokedex": "node tools/pokedex.mjs",
    "modelos": "node tools/modelos.mjs",
    "encaixe": "node tools/encaixe.mjs",
    "narracao": "node tools/narracao.mjs",
    "poses": "esbuild tools/poses.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/poses.mjs --log-level=error --external:draco3d --external:@gltf-transform/* && node node_modules/.cache/poses.mjs",
    "paineis": "esbuild tools/paineis.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/paineis.mjs --log-level=error --external:@napi-rs/canvas && node node_modules/.cache/paineis.mjs",
    "golpes": "node tools/golpes.mjs",
    "gritos": "node tools/gritos.mjs",
    "maos": "node tools/maos.mjs",
    "mao": "esbuild tools/mao.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/mao.mjs --log-level=error && node node_modules/.cache/mao.mjs",
    "vozes": "node tools/vozes.mjs",
    "vozes:anime": "node tools/vozes-anime.mjs",
    "luva": "node tools/luva.mjs",
    "rig": "esbuild tools/rig.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/rig.mjs --log-level=error --external:./raster.mjs --external:./png.mjs && node --max-old-space-size=4096 node_modules/.cache/rig.mjs",
    "ver:luva": "node tools/ver-luva.mjs",
    "tipos": "tsc --noEmit -p tsconfig.tools.json"
  },
  "dependencies": {
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.0",
    "@gltf-transform/extensions": "^4.5.0",
    "@napi-rs/canvas": "^1.0.9",
    "@types/node": "^26.6.1",
    "@types/three": "^0.184.0",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-basic-ssl": "^2.1.0",
    "draco3d": "^1.5.7",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
